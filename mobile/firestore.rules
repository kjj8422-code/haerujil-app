// Firestore 보안 규칙 — DATA_DESIGN.md의 컬렉션 구조에 맞춘 1단계 버전.
//
// 적용 방법: Firebase 콘솔 > Firestore Database > 규칙 탭 > 아래 내용 전체를
// 붙여넣고 "게시" 버튼 클릭. (이 파일 자체는 앱 코드가 아니라 "누가 읽고 쓸 수
// 있는지"를 정하는 설정 문서라, GitHub에 올려도 안전합니다.)
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 항·포구 정보: 누구나 읽을 수 있지만, 앱에서 직접 쓰지는 못한다.
    // (공공데이터 자동 수집 파이프라인은 서버 키로 접근하므로 이 규칙의 영향을 받지 않는다)
    match /harbors/{harborId} {
      allow read: if true;
      allow write: if false;
    }

    // 금어기·금지체장 규정: 누구나 읽기만, 쓰기는 관리자가 콘솔에서 직접.
    match /rules/{speciesId} {
      allow read: if true;
      allow write: if false;
    }

    // 제주 입수금지구역(2027.4.22 시행 예정, 69곳): 누구나 읽기만.
    match /jeju_no_entry_zones/{harborId} {
      allow read: if true;
      allow write: if false;
    }

    // 최근 법령 변경 이력: 누구나 읽기만.
    match /law_changes/{changeId} {
      allow read: if true;
      allow write: if false;
    }

    // 야간 해루질 안전관리요원 인정단체: 누구나 읽기만.
    match /safety_orgs/{orgId} {
      allow read: if true;
      allow write: if false;
    }

    // 전국 수상레저활동 금지구역(해양경찰청, 수상레저안전법 기준): 누구나 읽기만.
    match /leisure_restricted_zones/{zoneId} {
      allow read: if true;
      allow write: if false;
    }

    // 조과자랑 게시판: 누구나 읽고, 로그인(익명 포함)한 사용자만 "자기 글"로 작성 가능.
    // 수정·삭제는 아직 미지원(추후 신고/모더레이션 기능과 함께 추가 예정).
    match /board_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // 미니게임 랭킹: 문서 id를 uid로 강제해서, 본인 기록만 본인이 고칠 수 있게 한다.
    match /game_scores/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 사용자 프로필: 본인만 읽고 쓸 수 있다.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
